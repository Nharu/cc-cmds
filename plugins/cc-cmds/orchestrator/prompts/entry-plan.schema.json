{
  "type": "object",
  "properties": {
    "anchor_kind": { "type": "string", "enum": ["doc", "repo", "pr", "branch", "intent"] },
    "anchor_key": { "type": "string" },
    "entry_skill": { "type": "string", "enum": ["design", "design-audit", "implement", "review", "apply"] },
    "entry_rationale": { "type": "string" },
    "design_required": { "type": "boolean" },
    "design_rationale": { "type": "string" },
    "design_tier": { "type": "string", "enum": ["solo", "team-4"] },
    "design_tier_judged": { "type": "string", "enum": ["solo", "team-4"] },
    "design_heavy_reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "estimated_files": { "type": "integer", "minimum": 0 },
    "design_tier_rationale": { "type": "string" },
    "design_scope": { "type": "string", "enum": ["single", "base"] },
    "design_scope_rationale": { "type": "string" },
    "design_path": { "type": "string", "enum": ["solo-audit", "discuss-audit", "none"] },
    "visual_design_rationale": { "type": "string" },
    "work_class": { "type": "string", "enum": ["fix", "feat", "docs", "other", "unknown"] },
    "work_class_rationale": { "type": "string" },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alias": { "type": "string" },
          "remote_slug": { "type": "string" },
          "home": { "type": "boolean" },
          "why": { "type": "string" }
        },
        "required": ["alias", "remote_slug", "home", "why"],
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "skill": { "type": "string", "enum": ["design", "design-audit", "implement", "review", "apply", "split", "visual", "visual-publish"] },
          "summary": { "type": "string" },
          "depends_on": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "skill", "summary", "depends_on"],
        "additionalProperties": false
      }
    },
    "unresolved": { "type": "array", "items": { "type": "string" } },
    "enforcement_surface": {
      "type": "object",
      "properties": {
        "judgment": { "type": "string", "enum": ["확인됨", "가능성", "없음", "판정불가"] },
        "classes": { "type": "array", "items": { "type": "string", "enum": ["프로젝트설정", "트랜스크립트", "규칙카탈로그", "지침파일"] } },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "class": { "type": "string", "enum": ["프로젝트설정", "트랜스크립트", "규칙카탈로그", "지침파일"] },
              "slice": { "type": "string" }
            },
            "required": ["path", "class", "slice"],
            "additionalProperties": false
          }
        },
        "source": { "type": "string", "enum": ["의도", "선언", "PR"] },
        "rationale": { "type": "string" }
      },
      "required": ["judgment", "classes", "paths", "source", "rationale"],
      "additionalProperties": false
    },
    "run_profile": { "type": "string", "enum": ["hotfix", "standard"] },
    "review_expand": { "type": "array", "items": { "type": "string", "enum": ["요구", "문서표현"] } },
    "review_expand_rationale": { "type": "string" },
    "notes": { "type": "string" }
  },
  "required": ["anchor_kind", "anchor_key", "entry_skill", "entry_rationale", "design_required", "design_rationale", "design_tier", "design_tier_judged", "design_heavy_reasons", "estimated_files", "design_tier_rationale", "design_scope", "design_scope_rationale", "design_path", "visual_design_rationale", "work_class", "work_class_rationale", "targets", "steps", "unresolved", "enforcement_surface", "run_profile", "review_expand", "review_expand_rationale", "notes"],
  "additionalProperties": false
}
